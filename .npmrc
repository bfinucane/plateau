# pnpm v11 breaks Node module resolution in this environment: it links packages
# into node_modules as Windows DIRECTORY JUNCTIONS, and Node's resolver does not
# traverse junctions when walking up for transitive dependencies
# (fs.realpathSync returns the junction path itself, so `fdir`/`rollup` etc.
# under .pnpm/<pkg>/node_modules are never found).
#
# A hoisted, flat node_modules uses real directories and resolves normally.
node-linker=hoisted
